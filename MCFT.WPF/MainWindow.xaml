<Window x:Class="MCFT.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="MCFT Biaxial Failure Analysis" Height="900" Width="1600" WindowState="Normal">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.15*" MinWidth="100"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="0.10*" MinWidth="100"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="0.70*" MinWidth="900"/>
        </Grid.ColumnDefinitions>

        <!-- ============== LEFT PANEL: INPUT PARAMETERS (10%) ============== -->
        <ScrollViewer Grid.Column="0" Background="#F5F5F5">
            <StackPanel Margin="10">
                <TextBlock Text="INPUT" FontSize="12" FontWeight="Bold" Margin="0,0,0,12" Foreground="#333"/>

                <Border BorderBrush="#DADADA" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="CONCRETE" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" Foreground="#444"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="f'c" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.FcPrime, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ft" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.Ft, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ec" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.Ec, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ε₀" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.EpsilonNought, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="εcr" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.EpsilonCr, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DADADA" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="STEEL" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" Foreground="#444"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ρx" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.RhoX, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ρy" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.RhoY, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="fyx" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.Fyx, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="fyy" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.Fyy, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Es" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.Es, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DADADA" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="LOAD" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" Foreground="#444"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sigma x" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.Fx, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sigma y" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.Fy, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tau xy" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.Vxy, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DADADA" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="CRACK PROPERTIES" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" Foreground="#444"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Agg Size" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.AggregateSize, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Crck Sp. X" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.CrackSpacingX, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Crck Sp. Y" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.CrackSpacingY, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DADADA" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="STRESS SOLVER" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" Foreground="#444"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stress Tol" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.Tolerance, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Iterations" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.MaxIterations, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DADADA" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="CURVE SOLVER" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" Foreground="#444"/>                      

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Steps in Unit Stress Vector" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.NumberOfStepsInUnitStressVector, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Curve Max Steps" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.CurveMaxNumberOfSteps, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Refinements" VerticalAlignment="Center" FontSize="10"/>
                            <TextBox Grid.Column="1" Text="{Binding Input.Refinements, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="10" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Vertical Separator 1 -->
        <Separator Grid.Column="1" Width="2" Background="#DADADA" Margin="0,10"/>

        <!-- ============== MIDDLE PANEL: STRESS STATE RESULTS (10%) ============== -->
        <ScrollViewer Grid.Column="2" Background="#FAFAFA">
            <StackPanel Margin="10">
                <TextBlock Text="STRESS RESULTS" FontSize="12" FontWeight="Bold" Margin="0,0,0,12" Foreground="#333"/>

                <Border BorderBrush="#4CAF50" BorderThickness="2" Padding="10" Margin="0,0,0,10" Background="#E8F5E9" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" Foreground="#333"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="Conv:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.Converged}" FontSize="10" FontWeight="Bold" Foreground="#4CAF50"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Iter:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.Iterations}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DADADA" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="STRESSES" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" Foreground="#444"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="σX:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.SigmaX}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="σY:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.SigmaY}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="τXY:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.TauXY}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DADADA" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="STRAINS" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" Foreground="#444"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="εX:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.EpsilonX}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="εY:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.EpsilonY}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="γXY:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.GammaXY}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DADADA" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="PRINCIPAL" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" Foreground="#444"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="ε₁:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.Epsilon1}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="ε₂:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.Epsilon2}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="θ°:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.ThetaDegrees}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="fc₁:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.Fc1}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="fc₂:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.Fc2}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DADADA" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="STEEL &amp; SHEAR" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" Foreground="#444"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="fsx:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.Fsx}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="fsy:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.Fsy}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="vci:" Width="50" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentResult.Vci}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="RUN ANALYSIS" Padding="10,12" FontSize="11" FontWeight="Bold" 
                        Background="#4CAF50" Foreground="White" Margin="0,20,0,0" Cursor="Hand"
                        Command="{Binding RunAnalysisCommand}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Vertical Separator 2 -->
        <Separator Grid.Column="3" Width="2" Background="#DADADA" Margin="0,10"/>

        <!-- ============== RIGHT PANEL: CHARTS (80%) ============== -->
        <Grid Grid.Column="4" Background="#F5F5F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.50*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.50*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE: Stress-Strain Curves 4×2 Plot Grid -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0" Text="STRESS-STRAIN CURVES" FontSize="12" FontWeight="Bold" Margin="10,10,0,8" Foreground="#333"/>

                <!-- Chart Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column 1 -->
                    <!-- Row 0: σX vs εX -->
                    <oxy:PlotView Grid.Row="0" Grid.Column="0" Model="{Binding PlotModel_SigmaXvsEpsilonX}" Margin="8" Background="White"/>

                    <!-- Row 1: σY vs εY -->
                    <oxy:PlotView Grid.Row="1" Grid.Column="0" Model="{Binding PlotModel_SigmaYvsEpsilonY}" Margin="8" Background="White"/>

                    <!-- Row 2: τXY vs γXY -->
                    <oxy:PlotView Grid.Row="2" Grid.Column="0" Model="{Binding PlotModel_TauXYvsGammaXY}" Margin="8" Background="White"/>

                    <!-- Row 3: fsx vs εX -->
                    <oxy:PlotView Grid.Row="3" Grid.Column="0" Model="{Binding PlotModel_FsxvsEpsilonX}" Margin="8" Background="White"/>

                    <!-- Column 2 -->
                    <!-- Row 0: fc₁ vs ε₁ -->
                    <oxy:PlotView Grid.Row="0" Grid.Column="1" Model="{Binding PlotModel_Fc1vsEpsilon1}" Margin="8" Background="White"/>

                    <!-- Row 1: fc₂ vs ε₂ -->
                    <oxy:PlotView Grid.Row="1" Grid.Column="1" Model="{Binding PlotModel_Fc2vsEpsilon2}" Margin="8" Background="White"/>

                    <!-- Row 2: Vci vs ε₁ -->
                    <oxy:PlotView Grid.Row="2" Grid.Column="1" Model="{Binding PlotModel_VcivsEpsilon1}" Margin="8" Background="White"/>

                    <!-- Row 3: fsy vs εY -->
                    <oxy:PlotView Grid.Row="3" Grid.Column="1" Model="{Binding PlotModel_FsyvsEpsilonY}" Margin="8" Background="White"/>
                </Grid>
            </Grid>

            <!-- Vertical Separator 3 -->
            <Separator Grid.Column="1" Width="2" Background="#DADADA" Margin="0,10"/>

            <!-- RIGHT SIDE: Biaxial Envelope Plot (Full Height) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0" Text="BIAXIAL FAILURE ENVELOPE DIAGRAM" FontSize="12" FontWeight="Bold" Margin="10,10,0,8" Foreground="#333"/>

                <!-- Plot Container -->
                <oxy:PlotView Grid.Row="1" Model="{Binding PlotModel_BiaxialEnvelope}" Margin="8" Background="White"/>
            </Grid>
        </Grid>
    </Grid>
</Window>